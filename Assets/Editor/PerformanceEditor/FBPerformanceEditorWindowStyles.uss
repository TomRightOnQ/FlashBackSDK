.main-container {
    flex-grow: 1;
    flex-direction: column;
}

.main-content-horizontal {
    flex-grow: 1;
    flex-direction: row; /* This enables side-by-side layout */
    min-height: 0; /* Important for proper flexbox sizing */
}

.toolbar {
    flex-direction: row;
    height: 30px;
    background-color: rgb(60, 60, 60);
    padding: 4px;
    align-items: center;
}

.toolbar-button {
    margin-right: 4px;
    height: 20px;
}

.toolbar-spacer {
    flex-grow: 1;
}

.scene-title {
    color: white;
    font-size: 12px;
    unity-font-style: bold;
}

.content-area {
    flex-grow: 1;
    flex-direction: column;
    width: 50%;
    min-width: 0;
}

.welcome-screen {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    width: 100%;
}

.welcome-title {
    font-size: 24px;
    margin-bottom: 20px;
}

.welcome-button {
    width: 200px;
    height: 30px;
    margin: 8px;
}

.editor-content {
    flex-grow: 1;
    padding: 16px;
    flex-direction: column;
}

.track-content {
    width: 25%;
    min-width: 0;
    padding: 16px;
    flex-direction: column;
    border-left: 1px solid rgba(128, 128, 128, 0.3);
    background-color: rgba(30, 30, 30, 0.6);
}

.scene-name-field {
    margin-bottom: 16px;
}

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    z-index: 1000;
}

.loading-text {
    color: white;
    font-size: 18px;
    margin-bottom: 16px;
}

.loading-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-top: 4px solid white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

.entry-node {
    background-color: rgba(0, 100, 0, 0.8);
    border-color: rgb(0, 255, 0);
}

.entry-node .title {
    background-color: rgba(0, 80, 0, 0.9);
    color: white;
}

.exit-node {
    background-color: rgba(100, 0, 0, 0.8);
    border-color: rgb(255, 0, 0);
}

.exit-node .title {
    background-color: rgba(80, 0, 0, 0.9);
    color: white;
}

.exit-node {
    background-color: rgba(100, 0, 0, 0.8);
    border-color: rgb(255, 0, 0);
    min-width: 150px;
}

.exit-node .title {
    background-color: rgba(80, 0, 0, 0.9);
    color: white;
}

.add-port-button {
    font-size: 10px;
    height: 16px;
    margin: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.add-port-button:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.delete-port-button {
    font-size: 10px;
    width: 16px;
    height: 16px;
    margin-left: 4px;
    background-color: rgba(255, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
}

.delete-port-button:hover {
    background-color: rgba(255, 0, 0, 0.5);
}

.add-output-button {
    font-size: 10px;
    height: 16px;
    margin: 4px;
    background-color: rgba(0, 100, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
}

.add-output-button:hover {
    background-color: rgba(0, 100, 0, 0.5);
}

.delete-port-button {
    font-size: 10px;
    width: 16px;
    height: 16px;
    margin-left: 4px;
    background-color: rgba(255, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
}

.delete-port-button:hover {
    background-color: rgba(255, 0, 0, 0.5);
}

.test-timeline-button {
    background-color: rgba(0, 100, 200, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    font-size: 9px;
    height: 16px;
    margin: 4px;
}

.test-timeline-button:hover {
    background-color: rgba(0, 100, 200, 0.5);
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}